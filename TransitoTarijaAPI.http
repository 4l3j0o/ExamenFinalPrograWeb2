@HostAddress = http://localhost:5000

POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "numeroEscalafon": "ESC-1000",
  "password": "123456"
}

###

GET {{HostAddress}}/api/v1/accidentes?pagina=1&limite=10
Authorization: Bearer {{login.response.body.token}}

###

GET {{HostAddress}}/api/v1/estadisticas/puntos-criticos?anio=2024
Authorization: Bearer {{login.response.body.token}}
